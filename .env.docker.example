# Copy to .env.docker and fill in. .env.docker is gitignored.
#
# Plain KEY=value, no spaces around the =, no quotes needed. Straight quotes
# only if you use any - a curly quote from an editor's autocorrect is an
# ordinary character to bash and produces a confusing parse error, not a
# missing-key error.

# Required. Bills real money at fal.ai.
FAL_KEY=

# Optional - the servers ignore auth, but the tools exit if this is unset.
QWEN_API_KEY=pick-a-long-secret-string

# Optional overrides. Note QWEN_BASE_URL takes NO /v1 and REFMATCH_BASE_URL
# requires it.
#QWEN_BASE_URL=http://10.11.245.41:8091
#REFMATCH_BASE_URL=http://10.11.245.41:8091/v1

# Optional. The runs that shipped four picks generated ten candidates first.
#LAYDOWN_MAX_IMAGES=10
